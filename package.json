{
  "name": "dsh-plugin-agy-quota",
  "version": "1.0.2",
  "description": "DeepSeek Harness plugin for Antigravity Gemini quota monitoring in settings submenu agy-quota",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nursatechstudio/dsh-agy-gemini-quota.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "antigravity",
    "gemini",
    "quota"
  ],
  "homepage": "https://github.com/nursatechstudio/dsh-agy-gemini-quota#readme",
  "bugs": {
    "url": "https://github.com/nursatechstudio/dsh-agy-gemini-quota/issues"
  },
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "immediately": true
    }
  }
}

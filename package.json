{
  "name": "dsh-plugin-agy-quota",
  "version": "1.0.0",
  "description": "DeepSeek Harness plugin for Antigravity Gemini quota monitoring in settings submenu agy-quota",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/nursatechstudio/dsh-agy-gemini-quota.git"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "immediately": true
    }
  }
}

# Antigravity Gemini Quota Monitor - Authentication Config

# (Optional) Custom Google OAuth Client credentials
# Leave blank to use default Antigravity IDE OAuth client credentials
AGY_OAUTH_CLIENT_ID=
AGY_OAUTH_CLIENT_SECRET=

# (Optional) Manual Authentication Tokens
# If provided, the plugin can use these directly without IDE detection or OAuth login.
# Google OAuth Refresh Token (starts with 1//)
AGY_REFRESH_TOKEN=
# Google OAuth Access Token (starts with ya29.)
AGY_ACCESS_TOKEN=
